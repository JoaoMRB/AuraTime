<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AuraTime</AssemblyName>
    <RootNamespace>AuraTime.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The app sits in the tray all day: favour a small footprint over throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- The web app's translations: one source for the texts on the screen. -->
    <EmbeddedResource Include="..\..\public\assets\i18n\*.json" LogicalName="i18n.%(Filename).json" Link="i18n\%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings window: a page shown in WebView2. The fonts are the web app's own files. -->
    <Content Include="Ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\public\fonts\*.woff2" Link="Ui\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
