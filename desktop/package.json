    "@napi-rs/canvas": "^0.1.65",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.5.2"
  }
